# ─────────────────────────────────────────────────────────────
# Образ Python 3.14.8 (slim — облегчённый, ~50 МБ)
# ─────────────────────────────────────────────────────────────
FROM python:3.14.8-slim

# ─────────────────────────────────────────────────────────────
# Переменные окружения
# PYTHONDONTWRITEBYTECODE=1 — не создавать .pyc файлы (чище контейнер)
# PYTHONUNBUFFERED=1        — логи сразу в stdout, а не в буфер
#                             (важно для Railway: логи видны мгновенно)
# ─────────────────────────────────────────────────────────────
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# ─────────────────────────────────────────────────────────────
# Рабочая директория внутри контейнера
# ─────────────────────────────────────────────────────────────
WORKDIR /app

# ─────────────────────────────────────────────────────────────
# Системные зависимости
# gcc и build-essential нужны, если какая-то Python-библиотека
# собирается из исходников (например, psycopg без бинарного wheel).
# После установки pip их можно удалить — но это усложнит файл,
# для учебного проекта оставим.
# ─────────────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
        gcc \
        build-essential \
        libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# ─────────────────────────────────────────────────────────────
# Сначала копируем только requirements.txt — это позволяет
# Docker закешировать слой с установкой пакетов.
# При изменении кода (но не зависимостей) pip не будет
# переустанавливаться при каждой сборке.
# ─────────────────────────────────────────────────────────────
COPY requirements.txt .

# ─────────────────────────────────────────────────────────────
# Установка Python-зависимостей
# ─────────────────────────────────────────────────────────────
RUN pip install --no-cache-dir -r requirements.txt

# ─────────────────────────────────────────────────────────────
# Копируем весь остальной код проекта
# ─────────────────────────────────────────────────────────────
COPY . .

# ─────────────────────────────────────────────────────────────
# Railway передаёт порт через переменную окружения PORT.
# EXPOSE носит информационный характер — реальный порт
# определяется в CMD через ${PORT}.
# ─────────────────────────────────────────────────────────────
EXPOSE 8000

# ─────────────────────────────────────────────────────────────
# Команда запуска.
# ${PORT:-8000} — если переменная PORT не задана, использовать 8000.
# uvicorn доступен как системная команда, потому что pip
# установил его в /usr/local/bin (уже в PATH).
# ─────────────────────────────────────────────────────────────
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8080"